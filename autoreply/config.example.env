# Настройки автоответов. install.sh создаёт config.env сам и заполняет секреты.
DOMAIN=hushhold.uk
# Пароль от панели https://DOMAIN/admin (install.sh генерирует случайный)
ADMIN_PASSWORD=
SECRET_KEY=
# Любая строка; её же вписываешь в кабинете Meta в поле Verify token
VERIFY_TOKEN=
# Instagram App Secret: кабинет Meta → Instagram → API setup with Instagram login → Business login settings
IG_APP_SECRET=
# Данные приложения Meta удобнее вписать в панели; здесь можно продублировать
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
FB_GRAPH_VERSION=v25.0
# Токен можно вставить сюда или (удобнее) в панели
IG_ACCESS_TOKEN=
GRAPH_VERSION=v23.0
TIMEZONE=Europe/Madrid
BRAND_NAME=Hush&hold
# Почта для страниц /privacy и /data-deletion (Meta требует контакт)
CONTACT_EMAIL=
DB_PATH=/var/lib/hush-autoreply/data.db
HTTPS=true
